# Variáveis de ambiente do servidor (configure no painel da hospedagem; não grave segredos neste arquivo).
# Todas são opcionais para rodar localmente.

# Endereço público do site, sem barra no final. Vai para canonical, Open Graph, sitemap.xml e robots.txt.
SITE_URL=https://www.SEU-DOMINIO.com.br

# Atrás de proxy/HTTPS (Render, Railway, Nginx, Cloudflare): 1
TRUST_PROXY=1

# Redireciona http -> https (exige TRUST_PROXY=1)
FORCE_HTTPS=1

# A hospedagem normalmente já define PORT
# PORT=3000

# Supabase (padrão: o projeto gkypknwysbswbciptqpu). Só mude se trocar de projeto Supabase.
# A chave publishable é pública por desenho; NUNCA coloque a service_role aqui.
# SUPABASE_URL=https://gkypknwysbswbciptqpu.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Sistema ANTIGO de login do painel (users.json). Deixe desligado.
# Só ligue (1) para ler os pedidos LGPD em /api/admin/lgpd-requests; exige ADMIN_TOKEN forte.
# LEGACY_ADMIN=0
# ADMIN_TOKEN=
